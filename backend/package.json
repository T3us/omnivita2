{
  "name": "omnivita-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend proprio do OmniVita para auth, fichas e combate.",
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "migrate": "node scripts/apply-migrations.mjs",
    "backup:all": "node scripts/backup-all.mjs",
    "restore:backup": "node scripts/restore-backup.mjs",
    "restore:fresh": "npm run migrate && npm run seed:manual && npm run import:curated",
    "export:live": "node scripts/export-live-data.mjs",
    "import:live": "node scripts/import-live-export.mjs",
    "import:curated": "node scripts/import-curated-characters.mjs",
    "import:legacy": "node scripts/import-legacy-data.mjs",
    "seed:manual": "node scripts/seed-manual-data.mjs",
    "set-password": "node scripts/set-password.mjs",
    "check": "node --check server.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  }
}
